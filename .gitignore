# ==============================================================================
# 1. Environment & Secrets (NEVER commit secrets to public repos)
# ==============================================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Exceptions: Keep sanitized example templates
!.env.example
!.env.*.example

# Private keys, certificates & credentials
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ==============================================================================
# 2. Dependencies & Package Managers
# ==============================================================================
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# 3. Build & Compilation Artifacts
# ==============================================================================
# NestJS / TypeScript build outputs
dist/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo
.tscache/

# Next.js build outputs
.next/
out/
.open-next/

# ==============================================================================
# 4. Runtime Data, Logs & User Uploads
# ==============================================================================
logs/
*.log
backend/logs/
diag-output.log
output.txt
*-output.txt

# Dynamic user uploads & mentor session attachments
uploads/
backend/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep

# ==============================================================================
# 5. Python (Host Services & Monitoring Exporters)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# 6. Database & Local Scratch / Diagnostic Files
# ==============================================================================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ==============================================================================
# 7. Third-Party Binaries & Server Bundles
# ==============================================================================
keycloak-*/
keycloak-*.tar.gz
keycloak-*.zip

# ==============================================================================
# 8. Operating System & Editor Metadata
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Office temporary / lock files (e.g. ~$errors.docx)
~$*

# IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.qoder/

